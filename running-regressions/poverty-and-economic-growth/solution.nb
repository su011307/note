Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"OK", ",", " ", 
    RowBox[{
    "the", " ", "data", " ", "seems", " ", "to", " ", "have", " ", "some", " ",
      "certain", " ", "negative", " ", "relationship", " ", "between", " ", 
     "GDP", " ", "change", " ", "and", " ", "poverty", " ", "rate"}], ",", 
    " ", 
    RowBox[{
    "so", " ", "we", " ", "can", " ", "go", " ", "on", " ", "to", " ", "have",
      " ", "a", " ", "deeper", " ", "check"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"We", "'"}], "re", " ", "now", " ", "checking", " ", "the", " ", 
     "correlation", " ", "between", " ", "two", " ", "data", " ", 
     RowBox[{"sets", ".", " ", "Note"}], " ", "that", " ", "for", " ", 
     "single", " ", "variable", " ", "regression"}], ",", " ", 
    RowBox[{
     RowBox[{"there", "'"}], "s", " ", "no", " ", "difference", " ", 
     "between", " ", "\"\<dependent\>\"", " ", "and", 
     " ", "\"\<independent\>\"", " ", "variable"}], ",", " ", 
    RowBox[{
    "we", " ", "can", " ", "switch", " ", "their", " ", "order", " ", 
     "arbitrarily", " ", "for", " ", "pure", " ", "correlation", " ", 
     "purpose"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Correlation", "[", 
   RowBox[{
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
