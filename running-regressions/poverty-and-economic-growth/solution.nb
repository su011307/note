Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"We", "'"}], "ve", " ", "already", " ", "seen", " ", "the", " ", 
    "result", " ", "strongly", " ", "suggest", " ", "that", " ", "there", " ",
     "are", " ", "negative", " ", "relationship", " ", "between", " ", 
    "poverty", " ", "and", " ", "economic", " ", "growth"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Now", " ", 
    RowBox[{"let", "'"}], "s", " ", "do", " ", "a", " ", "real", " ", 
    "ordinary", " ", "least", " ", "square", 
